# Raw reference inputs consumed by file targets must be tracked so the pipeline
# builds on a fresh clone. Git cannot re-include a file whose parent directory
# is excluded, so data/raw/ is un-ignored and then re-ignored file-by-file.
!data/raw/
data/raw/*
!data/raw/Full_sample_filtered.dta
*_cache/
*.json
!.devcontainer/devcontainer.json
*.png
R_R/
*.exe
*.cfg
*_files/
notebooks/scratch/
scratch/
notebooks/*.rmarkdown
# Python virtual environment
Scripts/
Lib/
Include/
pyvenv.cfg
tests/
docs/claude_plans/

notebooks/unused/
*.html
